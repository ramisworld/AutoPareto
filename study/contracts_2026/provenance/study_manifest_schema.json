{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autopareto-contracts-2026-attempt-manifest-v1",
  "type": "object",
  "required": [
    "schema", "study_id", "campaign_id", "contract_id", "attempt_number",
    "training_seed", "parent_experiment_id", "hypothesis", "intended_change",
    "change_category", "candidate_source_before_sha256",
    "candidate_source_after_sha256", "candidate_patch", "starting_source_hash", "evaluator_hashes",
    "dataset_hashes", "tokenizer_hash", "program", "agent_context_files", "system_context_text", "agent_model_identifier",
    "reasoning_setting", "api_configuration_available", "training_environment",
    "gpu_identity", "command", "training_result", "inference_result",
    "inference_raw_repetitions", "pareto_decision", "checkpoint_hash"
  ],
  "properties": {
    "schema": {"const": "autopareto_contracts_2026_attempt_v1"},
    "study_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "contract_id": {"enum": ["T", "N"]},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 25},
    "training_seed": {"type": "integer", "minimum": 0},
    "parent_experiment_id": {"type": ["string", "null"]},
    "hypothesis": {"type": "string"},
    "intended_change": {"type": "string"},
    "change_category": {"type": "string"},
    "candidate_source_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_source_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_patch": {"type": ["string", "null"]},
    "starting_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_hashes": {"type": "object"},
    "dataset_hashes": {"type": "object"},
    "tokenizer_hash": {"type": "string"},
    "program": {"type": "object", "required": ["path", "sha256", "size_bytes", "content"]},
    "agent_context_files": {"type": "object"},
    "system_context_text": {"type": ["string", "null"]},
    "agent_model_identifier": {"type": "string"},
    "reasoning_setting": {"type": "string"},
    "api_configuration_available": {"type": "boolean"},
    "api_configuration": {"type": ["object", "null"]},
    "training_environment": {"type": "object"},
    "gpu_identity": {"type": "object"},
    "command": {"type": "array", "items": {"type": "string"}},
    "training_result": {"type": "object"},
    "inference_result": {"type": "object"},
    "inference_raw_repetitions": {"type": "array", "items": {"type": "number"}},
    "pareto_decision": {"type": "object"},
    "checkpoint_hash": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
